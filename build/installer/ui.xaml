<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="18" CornerRadius="18" ClipToBounds="False">
  <Border.Effect>
    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
  </Border.Effect>
  <Border.Resources>
    <SolidColorBrush x:Key="Text" Color="#EAEEFC"/>
    <SolidColorBrush x:Key="Muted" Color="#8D94AB"/>
    <SolidColorBrush x:Key="Panel2" Color="#14161C"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#40CCFF" Offset="0"/>
      <GradientStop Color="#5C6BFF" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="26,0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#07080C"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Halo" CornerRadius="12" Background="{StaticResource Accent}" Opacity="0">
                <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
              </Border>
              <Border x:Name="Bg" CornerRadius="11" Background="{StaticResource Accent}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              </Border>
              <Border CornerRadius="11" BorderThickness="0,1,0,0" BorderBrush="#66FFFFFF"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Halo" Property="Opacity" Value="0.55"/>
                <Setter TargetName="Bg" Property="Opacity" Value="0.94"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="11" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#1A40CCFF"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="#8040CCFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- checkbox drawn as an animated switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#26FFFFFF" VerticalAlignment="Top" Margin="0,2,14,0">
                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="KnobMove" X="0"/></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Border.Resources>

  <Border CornerRadius="18" ClipToBounds="True" BorderBrush="#2E40CCFF" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#13151C" Offset="0"/>
        <GradientStop Color="#0E1016" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===================== hero ===================== -->
      <Border Grid.Column="0" CornerRadius="18,0,0,18">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F2233" Offset="0"/>
            <GradientStop Color="#181339" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Ellipse x:Name="Glow" Width="260" Height="260" Margin="-60,-40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.5">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#9940CCFF" Offset="0"/>
                <GradientStop Color="#0040CCFF" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="240" Height="240" Margin="0,0,-90,-70" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.45">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#995C6BFF" Offset="0"/>
                <GradientStop Color="#005C6BFF" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <StackPanel VerticalAlignment="Center" Margin="30,0,24,40">
            <Canvas x:Name="Logo" Width="96" Height="96" HorizontalAlignment="Left">
              <Path Data="M48,4 L92,48 L48,92 L4,48 Z" Fill="{StaticResource Accent}">
                <Path.Effect><DropShadowEffect Color="#40CCFF" BlurRadius="30" ShadowDepth="0" Opacity="0.85"/></Path.Effect>
              </Path>
              <Path Data="M48,30 L66,48 L48,66 L30,48 Z" Fill="#8C0E1016"/>
            </Canvas>
            <TextBlock Text="JW Preset" FontSize="26" FontWeight="Bold" Margin="0,26,0,0"/>
            <TextBlock Text="Applicator Pro" FontSize="26" FontWeight="Bold" Margin="0,-4,0,0">
              <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#40CCFF" Offset="0"/>
                  <GradientStop Color="#8A95FF" Offset="1"/>
                </LinearGradientBrush>
              </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="for Adobe After Effects  ·  v1.3" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="30,0,0,28">
            <Border x:Name="Step0" Height="7" Width="22" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,6,0"/>
            <Border x:Name="Step1" Height="7" Width="7" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,6,0" Opacity="0.3"/>
            <Border x:Name="Step2" Height="7" Width="7" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,6,0" Opacity="0.3"/>
            <Border x:Name="Step3" Height="7" Width="7" CornerRadius="4" Background="{StaticResource Accent}" Opacity="0.3"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===================== content ===================== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Background="Transparent">
          <TextBlock Text="Setup" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="34,0,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
            <Button x:Name="MinBtn" Style="{StaticResource WinBtn}" Content="—"/>
            <Button x:Name="CloseBtn" Style="{StaticResource WinBtn}" Content="✕"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="34,6,34,30">

          <!-- 0: welcome -->
          <Grid x:Name="PageWelcome">
            <StackPanel>
              <TextBlock x:Name="WelcomeTitle" Text="Welcome" FontSize="24" FontWeight="Bold"/>
              <TextBlock x:Name="WelcomeBody" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20" Margin="0,10,0,0"
                         Text="Presets that fit every clip, frame-exact scene detection, background Topaz and exports, and a stack of editing tools, right inside After Effects."/>
              <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14,12" Margin="0,22,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Ellipse x:Name="AeDot" Width="9" Height="9" Fill="#4DE08C" VerticalAlignment="Top" Margin="0,5,12,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="After Effects" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="AeInfo" Text="Looking…" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Ellipse Width="9" Height="9" Fill="#40CCFF" VerticalAlignment="Top" Margin="0,5,12,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Just for you" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="Installs for this Windows user only. No admin rights, nothing outside your user folder." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Button x:Name="UninstallBtn" Style="{StaticResource Ghost}" Content="Remove" Margin="0,0,10,0" Visibility="Collapsed"/>
              <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="Install"/>
            </StackPanel>
          </Grid>

          <!-- 1: options -->
          <Grid x:Name="PageOptions">
            <StackPanel>
              <TextBlock Text="A couple of choices" FontSize="24" FontWeight="Bold"/>
              <TextBlock Text="The defaults are what most people want." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,22"/>
              <CheckBox x:Name="OptUnsigned" Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,0,18">
                <StackPanel>
                  <TextBlock Text="Let After Effects load this panel" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="Needed for any panel that isn't from Adobe Exchange. Turns on Adobe's extension setting for your user." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
              </CheckBox>
              <TextBlock Text="Nothing else is changed on your PC. To update or remove the panel later, run this setup again." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Button x:Name="BackBtn" Style="{StaticResource Ghost}" Content="Back" Margin="0,0,10,0"/>
              <Button x:Name="GoBtn" Style="{StaticResource Primary}" Content="Install now"/>
            </StackPanel>
          </Grid>

          <!-- 2: progress -->
          <Grid x:Name="PageProgress">
            <StackPanel>
              <TextBlock x:Name="ProgressTitle" Text="Installing" FontSize="24" FontWeight="Bold"/>
              <Grid Margin="0,10,0,0">
                <TextBlock x:Name="Status" Text="Getting ready…" Foreground="{StaticResource Muted}" FontSize="13"/>
                <TextBlock x:Name="Pct" Text="0%" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="#40CCFF"/>
              </Grid>
              <Border x:Name="BarTrack" Height="8" CornerRadius="4" Background="#26000000" Margin="0,12,0,24">
                <Border x:Name="BarFill" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource Accent}">
                  <Border.Effect><DropShadowEffect Color="#40CCFF" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                </Border>
              </Border>
              <StackPanel x:Name="LogList"/>
            </StackPanel>
            <Button x:Name="ProgressClose" Style="{StaticResource Ghost}" Content="Close" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
          </Grid>

          <!-- 3: done -->
          <Grid x:Name="PageDone">
            <StackPanel>
              <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource Accent}" HorizontalAlignment="Left">
                <Border.Effect><DropShadowEffect Color="#40CCFF" BlurRadius="26" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                <TextBlock Text="✓" FontSize="28" FontWeight="Bold" Foreground="#07080C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="DoneTitle" Text="You're all set" FontSize="24" FontWeight="Bold" Margin="0,20,0,0"/>
              <TextBlock x:Name="DoneBody" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="20" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Button x:Name="OpenFolderBtn" Style="{StaticResource Ghost}" Content="Show files" Margin="0,0,10,0" Visibility="Collapsed"/>
              <Button x:Name="FinishBtn" Style="{StaticResource Primary}" Content="Finish"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Border>
